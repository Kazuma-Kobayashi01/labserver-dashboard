<?xml version="1.0" encoding="utf-8"?>
<!-- Lab bot orb: a gradient sphere with the two eyes cut through it as round-ended slots, slanted 10 degrees, the same
     geometry as ui/BotAvatar.kt. Drawn in a 100-unit box and scaled into the 66 dp safe zone. -->
