    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
    <group android:translateX="12" android:translateY="12" android:scaleX="0.84" android:scaleY="0.84">
        <!-- soft glow under the orb -->
        <path android:pathData="M50,50m-40,0a40,40 0,1 1,80 0a40,40 0,1 1,-80 0">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="50" android:centerY="52" android:gradientRadius="40">
                    <item android:offset="0.7" android:color="#337B6CFF" />
                    <item android:offset="1" android:color="#007B6CFF" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- the orb, eyes cut out -->
        <path android:fillType="evenOdd"
            android:pathData="M50,50m-32,0a32,32 0,1 1,64 0a32,32 0,1 1,-64 0 M37.71,37.66 A3.68,3.68 0,0 1 44.96,38.94 L42.57,52.49 A3.68,3.68 0,0 1 35.33,51.21 Z M56.21,37.66 A3.68,3.68 0,0 1 63.46,38.94 L61.07,52.49 A3.68,3.68 0,0 1 53.82,51.21 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="27.6" android:startY="24.4" android:endX="72.4" android:endY="78.8">
                    <item android:offset="0" android:color="#8E80FF" />
                    <item android:offset="1" android:color="#3B2DC4" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- a little light on its upper left -->
        <path android:pathData="M30.5,36 a22,22 0,0 1,14 -14.5 a2.2,2.2 0,0 1,1.4 4.1 a18,18 0,0 0,-11.4 11.8 a2.2,2.2 0,0 1,-4 -1.4 Z"
            android:fillColor="#55FFFFFF" />
    </group>
</vector>
