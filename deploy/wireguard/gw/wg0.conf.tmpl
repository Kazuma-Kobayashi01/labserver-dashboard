# Home gateway: Incus container "wg-gw" (profile service, 10.0.0.30, boot.autostart, 256MiB/1cpu).
# Real file: /etc/wireguard/wg0.conf inside the container (private key in /etc/wireguard/gw.key), enabled via wg-quick@wg0.
# It only forwards the Mac (10.77.0.3) into the Incus subnet 10.0.0.0/24 (masqueraded as 10.0.0.30).
[Interface]
Address = 10.77.0.2/24
PrivateKey = __GW_PRIVATE_KEY__
PostUp = sysctl -qw net.ipv4.ip_forward=1
PostUp = iptables -P FORWARD DROP
PostUp = iptables -C FORWARD -i wg0 -o eth0 -s 10.77.0.3 -d 10.0.0.0/24 -j ACCEPT 2>/dev/null || iptables -A FORWARD -i wg0 -o eth0 -s 10.77.0.3 -d 10.0.0.0/24 -j ACCEPT
PostUp = iptables -C FORWARD -i eth0 -o wg0 -s 10.0.0.0/24 -d 10.77.0.3 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || iptables -A FORWARD -i eth0 -o wg0 -s 10.0.0.0/24 -d 10.77.0.3 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
PostUp = iptables -t nat -C POSTROUTING -s 10.77.0.3 -o eth0 -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 10.77.0.3 -o eth0 -j MASQUERADE

[Peer]
# VPS hub
PublicKey = <HUB_PUBLIC_KEY>
Endpoint = <VPS_PUBLIC_IP>:51820
AllowedIPs = 10.77.0.0/24
PersistentKeepalive = 25
