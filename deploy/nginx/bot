# Lab bot API: exposes only the chat endpoints of the Hermes API server (loopback :8642) for the `labbot` profile.
# Hermes itself checks the profile-scoped Bearer key (API_SERVER_KEY in ~/.hermes/profiles/labbot/.env); everything else
# (other profiles, sessions, cron, uploads, ...) is deliberately not proxied. Reachable only through the tunnel or LAN.
server {
    listen 80;
    listen [::]:80;
    server_name bot.labserver.internal;
    client_max_body_size 20m;          # images sent as data: URLs
    proxy_buffering off;               # server-sent events must not be buffered
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location = /p/labbot/v1/chat/completions { include snippets/labbot-proxy.conf; }
    location = /p/labbot/v1/models           { include snippets/labbot-proxy.conf; }
    location = /p/labbot/v1/capabilities     { include snippets/labbot-proxy.conf; }

    # bot-manager (sandboxed bots: list / create / trash / chat, and the chats the apps share), loopback :8650 through an
    # Incus proxy device;
    # the manager checks its own Bearer key, and only its documented routes are let through here.
    location ~ "^/m/v1/(health|models|media|chats/(b[0-9a-f]{10}|labbot)(/[A-Za-z0-9-]{1,64})?|bots(/(b[0-9a-f]{10}|labbot)(/restore|/chat/completions|/files|/runs/[A-Za-z0-9_.:-]{1,120}/approval)?)?)$" {   # quoted: braces
        proxy_pass http://127.0.0.1:8650;
        client_max_body_size 26m;          # one file for a sandbox bot is at most 25 MB
        proxy_request_buffering off;       # stream uploads through instead of spooling them
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
    }

    # a bot's terminal (bot-manager, behind its key): a WebSocket kept open as long as the app keeps it
    location ~ "^/m/v1/bots/(b[0-9a-f]{10}|labbot)/shell$" {   # quoted: braces
        proxy_pass http://127.0.0.1:8650;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
    }

    location / { return 404; }
}
